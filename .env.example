# --- Docker compose (infrastructure) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
SEARXNG_SECRET=
ADMIN_PASSWORD=

# --- Required (app refuses to start without these) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# --- Database (default is local SQLite; Postgres optional) ---
DATABASE_URL=sqlite+aiosqlite:///./pmbuilder.db
# DATABASE_URL=postgresql+asyncpg://pmuser:CHANGE_ME@localhost:5432/pmbuilder

# --- Optional services ---
REDIS_URL=
DUCKDB_PATH=./data/analytics.duckdb
LANCEDB_PATH=./data/vectors
CHROMADB_PATH=./data/memory
ORACLE_INSTANCE_ID=
CLOUDFLARE_API_TOKEN=
RLM_ARCHIVE_ROOT=./data/archives

# --- LLM keys ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
HERMES_INFERENCE_MODEL=

# --- Model settings ---
TABPFN_MODEL=tabpfn-2.5
TABPFN_MODE=local
MARKET_REGIME_MODEL=heuristic-ensemble

# --- Auth / HTTP ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
